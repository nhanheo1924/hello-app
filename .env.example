# Local PostgreSQL (direct host connection, no Docker internal host)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ctm-auth-service
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Optional explicit service URLs (if omitted, scripts derive from POSTGRES_* + schema)
# AUTH_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ctm-auth-service?schema=public
# TASK_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ctm-auth-service?schema=task

# Local auth/task token settings
JWT_ISSUER_LOCAL=http://localhost:3000
JWT_AUDIENCE=ctm-web
JWT_ACTIVE_KID=ctm-dev-kid-1
JWT_ACCESS_PRIVATE_KEY=
JWT_ACCESS_PUBLIC_KEY=
JWT_PUBLIC_KEYS_JSON=[]
INTERNAL_PROXY_SECRET=dev-internal-proxy-secret-0123456789ab
TOTP_ENCRYPTION_SECRET_LOCAL=

# Local frontend callback URLs
WEB_APP_URL_LOCAL=http://localhost:5173
WEB_APP_OAUTH_CALLBACK_URL_LOCAL=http://localhost:5173/auth/callback/
GOOGLE_OAUTH_REDIRECT_URI_LOCAL=http://localhost:3001/api/v1/auth/google/callback

# Local BFF/upstream wiring
BFF_PROXY_TARGET_URL_LOCAL=http://localhost:3001
AUTH_SERVICE_BASE_URL_LOCAL=http://localhost:3000/api/auth
TASK_SERVICE_BASE_URL_LOCAL=http://localhost:3102/api

# Optional local web env overrides
VITE_API_BASE_URL_LOCAL=/api/v1
VITE_FRONTEND_URL_LOCAL=http://localhost:5173
VITE_OAUTH_CALLBACK_PATH_LOCAL=/auth/callback/

# Optional Cloudflared tunnel mode
# Set true to make env:sync derive API/callback URLs from tunnel values.
USE_CLOUDFLARED_TUNNEL_LOCAL=false
CLOUDFLARED_TUNNEL_API_URL_LOCAL=
CLOUDFLARED_TUNNEL_WEB_URL_LOCAL=

# Optional Cloudflare Zero Trust Access (Service Token) for scripts calling tunnel URLs
CLOUDFLARE_ZA_CLIENT_ID_LOCAL=
CLOUDFLARE_ZA_CLIENT_SECRET_LOCAL=
# Alias names (supported by verify scripts)
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=

BFF_CORS_ORIGIN_LOCAL=http://localhost:5173,http://127.0.0.1:5173
SERVICE_CORS_ORIGIN_LOCAL=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3001

# Optional OAuth credentials
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Optional production references (set in deployment platform env, not in local git files)
# VITE_API_BASE_URL=https://api.your-domain.com/api/v1
# VITE_FRONTEND_URL=https://your-frontend-domain.com
