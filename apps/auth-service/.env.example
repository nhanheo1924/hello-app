NODE_ENV=development
APP_HOST=0.0.0.0
APP_PORT=3000
APP_PREFIX=api
CORS_ORIGIN=https://nhanctm.site,https://www.nhanctm.site,http://localhost:5173,http://localhost:3001

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ctm-auth-service?schema=public
REDIS_URL=redis://localhost:6379

JWT_ACCESS_EXPIRES_IN=60m  # tokens last one hour by default
REFRESH_TOKEN_EXPIRES_IN=3d
AUTH_REFRESH_COOKIE_NAME=ctm_rt
JWT_ISSUER=http://localhost:3000
JWT_AUDIENCE=ctm-web
JWT_ACTIVE_KID=ctm-dev-kid-1
JWT_ACCESS_PRIVATE_KEY=
JWT_ACCESS_PUBLIC_KEY=
JWT_PUBLIC_KEYS_JSON=[]
TWO_FACTOR_CHALLENGE_EXPIRES_IN=5m
TOTP_ISSUER=CTM Auth
TOTP_ENCRYPTION_SECRET=
INTERNAL_PROXY_SECRET=dev-internal-proxy-secret-0123456789ab
AUTH_PUBLIC_BASE_PATH=/api/v1/auth
WEB_APP_URL=http://localhost:5173
WEB_APP_OAUTH_CALLBACK_URL=http://localhost:5173/auth/callback/
OAUTH_EXCHANGE_CODE_EXPIRES_IN=60s
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3001/api/v1/auth/google/callback
RESEND_API_KEY=
RESEND_FROM=auth@nhanctm.site
EMAIL_OTP_TTL_SECONDS=300
EMAIL_OTP_RATE_LIMIT_SECONDS=60
EMAIL_OTP_VERIFICATION_TTL_SECONDS=600
