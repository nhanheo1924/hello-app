NODE_ENV=development
APP_HOST=0.0.0.0
APP_PORT=3000
APP_PREFIX=api
CORS_ORIGIN=https://nhanctm.site,https://www.nhanctm.site,http://localhost:5173

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ctm-auth-service?schema=public

JWT_ACCESS_EXPIRES_IN=60m  # tokens last one hour by default
JWT_ISSUER=http://localhost:3000
JWT_AUDIENCE=ctm-web
JWT_ACTIVE_KID=ctm-dev-kid-1
JWT_ACCESS_PRIVATE_KEY=
JWT_ACCESS_PUBLIC_KEY=
JWT_PUBLIC_KEYS_JSON=[]
TWO_FACTOR_CHALLENGE_EXPIRES_IN=5m
TOTP_ISSUER=CTM Auth
TOTP_ENCRYPTION_SECRET=
INTERNAL_PROXY_SECRET=dev-internal-proxy-secret-0123456789ab
WEB_APP_URL=http://localhost:5173
WEB_APP_OAUTH_CALLBACK_URL=http://localhost:5173/auth/callback/
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:5173/api/auth/google/callback
