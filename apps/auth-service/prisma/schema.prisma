generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  LOCKED
  DISABLED

  @@map("user_status")
}

enum SessionRevokeReason {
  NEW_LOGIN
  LOGOUT
  REFRESH_REUSE
  ADMIN
  SECURITY

  @@map("session_revoke_reason")
}

enum AuditAction {
  REGISTER
  LOGIN_OK
  LOGIN_FAIL
  REFRESH_OK
  REFRESH_FAIL
  LOGOUT
  SESSION_REVOKED
  SECURITY_EVENT

  @@map("audit_action")
}

enum SystemRole {
  SUPER_ADMIN
  SYSTEM_ADMIN
  USER

  @@map("system_role")
}

model User {
  id                   String       @id @default(uuid()) @db.Uuid
  email                String       @unique
  passwordHash         String       @map("password_hash")
  status               UserStatus   @default(ACTIVE)
  systemRole           SystemRole   @default(USER) @map("system_role")
  firstName            String?      @map("first_name") @db.VarChar(120)
  lastName             String?      @map("last_name") @db.VarChar(120)
  displayName          String?      @map("display_name") @db.VarChar(120)
  dob                  DateTime?    @db.Date
  address              String?      @db.VarChar(255)
  avatarUrl            String?      @map("avatar_url") @db.VarChar(512)
  timezone             String?      @db.VarChar(64)
  locale               String?      @db.VarChar(16)
  emailVerifiedAt      DateTime?    @map("email_verified_at")
  lastLoginAt          DateTime?    @map("last_login_at")
  fullName             String?      @map("full_name")
  googleId             String?      @unique @map("google_id")
  twoFactorEnabled     Boolean      @default(false) @map("two_factor_enabled")
  twoFactorSecret      String?      @map("two_factor_secret")
  twoFactorTempSecret  String?      @map("two_factor_temp_secret")
  twoFactorBackupCodes Json?        @map("two_factor_backup_codes")
  createdAt            DateTime     @default(now()) @map("created_at")
  updatedAt            DateTime     @updatedAt @map("updated_at")
  sessions             Session[]
  auditLogs            AuditLog[]

  @@index([status, systemRole], map: "users_status_system_role_idx")
  @@map("users")
}

model Session {
  id           String               @id @db.Uuid
  userId       String               @map("user_id") @db.Uuid
  ip           String?
  userAgent    String?              @map("user_agent")
  deviceId     String?              @map("device_id")
  createdAt    DateTime             @default(now()) @map("created_at")
  lastSeenAt   DateTime?            @map("last_seen_at")
  revokedAt    DateTime?            @map("revoked_at")
  revokeReason SessionRevokeReason? @map("revoke_reason")
  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([userId])
  @@index([revokedAt])
  @@map("sessions")
}

model RefreshToken {
  id                String   @id @db.Uuid
  sessionId         String   @map("session_id") @db.Uuid
  tokenHash         String   @map("token_hash")
  createdAt         DateTime @default(now()) @map("created_at")
  expiresAt         DateTime @map("expires_at")
  revokedAt         DateTime? @map("revoked_at")
  replacedByTokenId String?  @map("replaced_by_token_id") @db.Uuid
  createdByIp       String?  @map("created_by_ip")
  createdByUserAgent String? @map("created_by_user_agent")
  lastUsedAt        DateTime? @map("last_used_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  session           Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([expiresAt])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

model AuditLog {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String?   @map("user_id") @db.Uuid
  email     String?
  ip        String?
  userAgent String?   @map("user_agent")
  action    AuditAction
  detail    Json?
  createdAt DateTime  @default(now()) @map("created_at")
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

model OauthExchangeCode {
  id         String    @id @default(uuid()) @db.Uuid
  codeHash   String    @unique @map("code_hash")
  payloadJson Json     @map("payload_json")
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([expiresAt], map: "oauth_exchange_codes_expires_at_idx")
  @@map("oauth_exchange_codes")
}
