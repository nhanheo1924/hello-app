NODE_ENV=development
APP_HOST=0.0.0.0
APP_PORT=3001
APP_PREFIX=api/v1
CORS_ORIGIN=http://localhost:5173,https://nhanctm.site,https://www.nhanctm.site

AUTH_SERVICE_BASE_URL=http://localhost:3000/api/auth
TASK_SERVICE_BASE_URL=http://localhost:3102/api
AUTH_ACCESS_COOKIE_NAME=ctm_at
AUTH_ACCESS_COOKIE_DOMAIN=
AUTH_ACCESS_COOKIE_SAMESITE=strict

INTERNAL_PROXY_SECRET=dev-internal-proxy-secret-0123456789ab
UPSTREAM_TIMEOUT_MS=15000
AUTH_CRITICAL_UPSTREAM_TIMEOUT_MS=8000
UPSTREAM_MAX_ATTEMPTS=3
UPSTREAM_RETRY_DELAY_MS=400
