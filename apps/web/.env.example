# Frontend runtime (built into client bundle)
VITE_APP_BASE_PATH=/
VITE_API_BASE_URL=/api/v1
VITE_FRONTEND_URL=http://localhost:5173
VITE_OAUTH_CALLBACK_PATH=/auth/callback/

# Dev server proxy target to BFF (server-side only, safe to keep private)
BFF_PROXY_TARGET_URL=http://localhost:3001

# Optional internal header for backend proxy guard
INTERNAL_PROXY_SECRET=dev-internal-proxy-secret-0123456789ab
